    <script>
        // === STARS THAT REACT TO CURSOR (subtle magic) ===
        const canvas = document.getElementById('star-canvas');
        const ctx = canvas.getContext('2d');
        let stars = [];
        let mouse = { x: 0, y: 0 };

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        class Star {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2.8 + 0.6;
                this.speed = Math.random() * 0.6 + 0.2;
                this.baseX = this.x;
                this.baseY = this.y;
            }
            update() {
                // Gentle pull toward cursor
                const dx = mouse.x - this.x;
                const dy = mouse.y - this.y;
                const distance = Math.sqrt(dx * dx + dy * dy);
                if (distance < 280) {
                    this.x += dx * 0.018;
                    this.y += dy * 0.018;
                }
                // Gentle drift back
                this.x += (this.baseX - this.x) * 0.008;
                this.y += (this.baseY - this.y) * 0.008;
                // Twinkle
                this.size = Math.sin(Date.now() / 180 * this.speed) * 0.8 + 1.6;
            }
            draw() {
                ctx.fillStyle = '#E8C4A0';
                ctx.globalAlpha = Math.random() * 0.7 + 0.3;
                ctx.fillRect(this.x, this.y, this.size, this.size);
            }
        }

        function initStars() {
            stars = [];
            for (let i = 0; i < 160; i++) {
                stars.push(new Star());
            }
        }

        function animateStars() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            stars.forEach(star => {
                star.update();
                star.draw();
            });
            requestAnimationFrame(animateStars);
        }

        window.addEventListener('mousemove', (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
        });

        window.addEventListener('resize', () => {
            resizeCanvas();
            initStars();
        });

        // === INK ANIMATION already handled in CSS + SVG ===
        // === MEANING REVEAL on Featured Cards ===
        function addRevealFunctionality() {
            const cards = document.querySelectorAll('.work-card');
            cards.forEach(card => {
                card.addEventListener('click', () => {
                    card.classList.toggle('revealed');
                    // Auto-hide after 6 seconds so it doesn't stay cluttered
                    if (card.classList.contains('revealed')) {
                        setTimeout(() => {
                            card.classList.remove('revealed');
                        }, 6200);
                    }
                });
            });
        }

        // === SCROLL REVEAL (your original) ===
        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });

        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add('visible');
                    }, index * 100);
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.scroll-reveal').forEach(el => {
            observer.observe(el);
        });

        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Initialize everything
        window.onload = () => {
            resizeCanvas();
            initStars();
            animateStars();
            addRevealFunctionality();
            console.log('%c✨ Ink of Arabia loaded with live ink + reactive stars + meaning reveal ✨', 'color:#D4A574; font-family:Playfair Display; font-size:13px;');
        };
    </script>
