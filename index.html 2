<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Ink of Arabia - Personalized Arabic Calligraphy Art. Custom names, Quranic verses, wedding designs & bespoke pieces crafted with centuries-old tradition and modern elegance.">
    <meta name="keywords" content="Arabic calligraphy, personalized calligraphy, Islamic art, custom name art, Quranic verse art, wedding calligraphy, Arabic script art">
    <meta name="author" content="Ink of Arabia">
    
    <!-- Open Graph / Social Media -->
    <meta property="og:title" content="Ink of Arabia - Personalized Arabic Calligraphy Art">
    <meta property="og:description" content="Every stroke tells your story. Handcrafted Arabic calligraphy made with love.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://inkofarabia.com">
    <meta property="og:image" content="https://res.cloudinary.com/dg4vourvl/image/upload/f_auto,q_auto/v1776705444/671285661_17879731872554162_1677592347961833773_n.heic_hcy3uw.jpg">

    <title>Ink of Arabia - Personalized Arabic Calligraphy Art</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Crimson+Text:ital@0;1&family=Lora:wght@500;600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            /* Primary Colors */
            --maroon-primary: #6B0F2A;
            --maroon-accent: #8B1A3F;
            --maroon-shadow: #4A0820;
            
            /* Neutrals */
            --cream: #FEFDFB;
            --beige: #F5F0E8;
            --gray-light: #E8E3DB;
            --charcoal: #1A1714;
            
            /* Accents */
            --gold: #D4A574;
            --gold-light: #E8C4A0;
            --rose-gold: #C9896B;
            
            /* Fonts */
            --font-display: 'Playfair Display', serif;
            --font-serif: 'Crimson Text', serif;
            --font-body: 'Lora', serif;
            --font-ui: 'Poppins', sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--cream);
            color: var(--charcoal);
            font-family: var(--font-body);
            line-height: 1.8;
            font-size: 16px;
            overflow-x: hidden;
            position: relative;
        }

        /* STAR CANVAS - subtle magical background */
        #star-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
            opacity: 0.18;
            mix-blend-mode: multiply;
        }

        /* NAVBAR */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            padding: 20px 60px;
            background: transparent;
            transition: all 0.4s ease;
        }

        nav.scrolled {
            background: rgba(254, 253, 251, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(107, 15, 42, 0.08);
            padding: 15px 60px;
        }

        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: var(--font-display);
            font-size: 28px;
            font-weight: 700;
            color: var(--maroon-primary);
            letter-spacing: 1px;
            transition: color 0.3s ease;
        }

        nav.scrolled .logo {
            font-size: 24px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 50px;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--charcoal);
            font-family: var(--font-ui);
            font-size: 14px;
            font-weight: 500;
            position: relative;
            transition: color 0.3s ease;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--gold);
            transition: width 0.3s ease;
        }

        .nav-links a:hover,
        .nav-links a:focus {
            color: var(--maroon-primary);
        }

        .nav-links a:hover::after,
        .nav-links a:focus::after {
            width: 100%;
        }

        /* HERO SECTION */
        .hero {
            height: 100vh;
            background: linear-gradient(135deg, var(--cream) 0%, var(--beige) 100%);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 80px 60px;
            gap: 60px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(212, 165, 116, 0.15) 0%, transparent 70%);
            border-radius: 50%;
            animation: float 8s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(-30px, 30px); }
        }

        .hero-content {
            flex: 1;
            z-index: 2;
            animation: slideInLeft 0.8s ease 0.2s both;
        }

        @keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .hero h1 {
            font-family: var(--font-display);
            font-size: 64px;
            color: var(--maroon-primary);
            line-height: 1.2;
            margin-bottom: 20px;
            font-weight: 700;
            letter-spacing: -1px;
        }

        .hero-subtitle {
            font-family: var(--font-serif);
            font-size: 18px;
            color: var(--charcoal);
            margin-bottom: 40px;
            font-style: italic;
            opacity: 0.9;
        }

        .hero-accent {
            width: 50px;
            height: 3px;
            background: linear-gradient(90deg, var(--maroon-primary), var(--gold));
            margin-bottom: 30px;
            border-radius: 2px;
            animation: drawLine 1s ease 0.4s both;
        }

        @keyframes drawLine {
            from {
                width: 0;
            }
            to {
                width: 50px;
            }
        }

        .hero-cta {
            display: inline-block;
        }

        .btn {
            padding: 16px 40px;
            border: 2px solid var(--maroon-primary);
            background: var(--maroon-primary);
            color: var(--cream);
            font-family: var(--font-ui);
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            letter-spacing: 0.5px;
        }

        .btn:hover {
            background: var(--rose-gold);
            border-color: var(--rose-gold);
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(107, 15, 42, 0.25);
        }

        .btn-ghost {
            background: transparent;
            color: var(--maroon-primary);
            margin-left: 20px;
        }

        .btn-ghost:hover {
            background: var(--maroon-primary);
            color: var(--cream);
        }

        /* HERO IMAGE - NOW WITH LIVE INK ANIMATION */
        .hero-image {
            flex: 1;
            height: 500px;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--maroon-primary), var(--maroon-accent));
            position: relative;
            overflow: hidden;
            animation: slideInRight 0.8s ease 0.3s both;
            box-shadow: 0 20px 60px rgba(107, 15, 42, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .hero-image::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><path d="M 20,80 Q 50,20 80,80" stroke="%23D4A574" stroke-width="2" fill="none" opacity="0.3"/><path d="M 30,60 Q 50,30 70,60" stroke="%23E8C4A0" stroke-width="1.5" fill="none" opacity="0.2"/></svg>');
            background-size: 200px 200px;
            animation: drift 6s ease-in-out infinite;
        }

        @keyframes drift {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(20px, -20px); }
        }

        /* INK SIGNATURE ANIMATION */
        .ink-animation {
            width: 380px;
            height: 320px;
            position: relative;
            z-index: 2;
        }

        .ink-animation svg {
            width: 100%;
            height: 100%;
        }

        .ink-animation text {
            font-family: var(--font-display);
            font-size: 110px;
            fill: none;
            stroke: #E8C4A0;
            stroke-width: 9;
            stroke-dasharray: 1200;
            stroke-dashoffset: 1200;
            animation: inkDraw 4.2s ease forwards 0.6s;
        }

        .ink-animation .signature {
            font-family: var(--font-display);
            font-size: 22px;
            fill: #D4A574;
            opacity: 0;
            animation: signatureFade 1s ease forwards 4.8s;
        }

        @keyframes inkDraw {
            to {
                stroke-dashoffset: 0;
            }
        }

        @keyframes signatureFade {
            to {
                opacity: 1;
            }
        }

        .hero-image-text {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            color: var(--cream);
            z-index: 3;
            opacity: 0;
            animation: fadeInText 1s ease forwards 5.5s;
        }

        @keyframes fadeInText {
            to {
                opacity: 0.95;
            }
        }

        /* FEATURED SECTION */
        section {
            padding: 100px 60px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-title {
            font-family: var(--font-display);
            font-size: 48px;
            color: var(--maroon-primary);
            margin-bottom: 60px;
            text-align: center;
            font-weight: 700;
            position: relative;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            border-radius: 2px;
        }

        .featured-works {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 40px;
            margin-top: 80px;
        }

        .work-card {
            height: 350px;
            border-radius: 12px;
            overflow: hidden;
            background-size: cover;
            background-position: center;
            cursor: pointer;
            position: relative;
            transition: all 0.4s ease;
            box-shadow: 0 10px 40px rgba(107, 15, 42, 0.15);
            border: 1px solid rgba(212, 165, 116, 0.2);
        }

        .work-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 30%, rgba(212, 165, 116, 0.3), transparent 70%);
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .work-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 60px rgba(212, 165, 116, 0.3);
            border-color: var(--gold);
        }

        .work-card:hover::before {
            opacity: 1;
        }

        .work-card-content {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 30px;
            background: linear-gradient(180deg, transparent 0%, rgba(26, 23, 20, 0.85) 100%);
            position: relative;
            z-index: 2;
            color: var(--cream);
            transition: all 0.4s ease;
        }

        /* MEANING REVEAL - click to discover */
        .work-card.revealed .work-card-content::after {
            content: attr(data-meaning);
            position: absolute;
            inset: 0;
            background: rgba(26, 23, 20, 0.92);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 30px;
            text-align: center;
            font-size: 15px;
            line-height: 1.6;
            opacity: 0;
            animation: revealFade 0.6s forwards;
        }

        @keyframes revealFade {
            to { opacity: 1; }
        }

        .work-card-content .reveal-hint {
            font-size: 11px;
            letter-spacing: 1.5px;
            opacity: 0.6;
            margin-top: 8px;
        }

        .work-card-title {
            font-family: var(--font-display);
            font-size: 24px;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .work-card-type {
            font-family: var(--font-ui);
            font-size: 12px;
            color: var(--gold);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Rest of your original CSS remains untouched */
        .philosophy {
            background: linear-gradient(135deg, var(--cream) 0%, var(--beige) 100%);
        }

        .philosophy-content {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .philosophy-text h2 {
            font-family: var(--font-display);
            font-size: 42px;
            color: var(--maroon-primary);
            margin-bottom: 30px;
            font-weight: 700;
            line-height: 1.3;
        }

        .philosophy-text p {
            margin-bottom: 20px;
            color: var(--charcoal);
            opacity: 0.9;
            line-height: 1.9;
        }

        .philosophy-text .accent-quote {
            font-size: 18px;
            font-style: italic;
            color: var(--maroon-primary);
            border-left: 4px solid var(--gold);
            padding-left: 20px;
            margin: 30px 0;
        }

        .philosophy-image {
            height: 400px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--maroon-primary), var(--rose-gold));
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(107, 15, 42, 0.15);
        }

        .services {
            background: var(--cream);
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            margin-top: 80px;
        }

        .service-card {
            padding: 40px 30px;
            background: var(--beige);
            border-radius: 12px;
            border: 2px solid transparent;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
        }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--maroon-primary), var(--gold));
            border-radius: 12px 12px 0 0;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .service-card:hover {
            background: var(--cream);
            border-color: var(--gold);
            box-shadow: 0 10px 40px rgba(107, 15, 42, 0.1);
        }

        .service-card:hover::before {
            transform: scaleX(1);
        }

        .service-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--maroon-primary), var(--maroon-accent));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            font-size: 28px;
        }

        .service-card h3 {
            font-family: var(--font-display);
            font-size: 22px;
            color: var(--maroon-primary);
            margin-bottom: 15px;
            font-weight: 700;
        }

        .service-card p {
            font-size: 14px;
            color: var(--charcoal);
            opacity: 0.8;
            line-height: 1.7;
        }

        .testimonials {
            background: linear-gradient(135deg, var(--beige) 0%, var(--cream) 100%);
        }

        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 40px;
            margin-top: 80px;
        }

        .testimonial-card {
            background: var(--cream);
            padding: 40px;
            border-radius: 12px;
            border: 1px solid var(--gray-light);
            box-shadow: 0 5px 20px rgba(107, 15, 42, 0.08);
            transition: all 0.3s ease;
            position: relative;
        }

        .testimonial-card::before {
            content: '"';
            position: absolute;
            top: 10px;
            left: 20px;
            font-size: 80px;
            color: var(--gold);
            opacity: 0.3;
            font-family: var(--font-display);
        }

        .testimonial-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(107, 15, 42, 0.12);
        }

        .testimonial-text {
            font-size: 15px;
            color: var(--charcoal);
            margin-bottom: 25px;
            line-height: 1.8;
            position: relative;
            z-index: 1;
        }

        .testimonial-stars {
            color: var(--gold);
            margin-bottom: 20px;
            font-size: 14px;
            letter-spacing: 2px;
        }

        .testimonial-author {
            font-family: var(--font-display);
            font-size: 16px;
            color: var(--maroon-primary);
            font-weight: 700;
        }

        .testimonial-title {
            font-family: var(--font-ui);
            font-size: 12px;
            color: var(--gold);
            margin-top: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .final-cta {
            background: linear-gradient(135deg, var(--maroon-shadow) 0%, var(--maroon-primary) 100%);
            color: var(--cream);
            text-align: center;
            padding: 120px 60px;
            position: relative;
            overflow: hidden;
        }

        .final-cta::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><path d="M0,50 Q25,25 50,50 T100,50" stroke="%23D4A574" stroke-width="0.5" fill="none" opacity="0.1"/></svg>');
            background-size: 200px 200px;
            opacity: 0.5;
        }

        .final-cta-content {
            position: relative;
            z-index: 2;
        }

        .final-cta h2 {
            font-family: var(--font-display);
            font-size: 52px;
            margin-bottom: 20px;
            font-weight: 700;
            line-height: 1.3;
        }

        .final-cta p {
            font-size: 18px;
            margin-bottom: 40px;
            opacity: 0.95;
            font-style: italic;
        }

        .btn-light {
            background: var(--gold);
            color: var(--charcoal);
            border-color: var(--gold);
        }

        .btn-light:hover {
            background: var(--gold-light);
            border-color: var(--gold-light);
            color: var(--charcoal);
        }

        /* FOOTER */
        footer {
            background: var(--charcoal);
            color: var(--cream);
            padding: 80px 60px 40px;
            position: relative;
            border-top: 2px solid var(--gold);
        }

        .footer-content {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 60px;
            margin-bottom: 60px;
        }

        .footer-section h4 {
            font-family: var(--font-display);
            font-size: 18px;
            margin-bottom: 20px;
            color: var(--gold);
            font-weight: 700;
        }

        .footer-section p, .footer-section a {
            font-size: 14px;
            line-height: 1.8;
            color: rgba(254, 253, 251, 0.8);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-section a:hover {
            color: var(--gold);
        }

        .social-links {
            display: flex;
            gap: 20px;
            margin-top: 15px;
        }

        .social-links a {
            width: 40px;
            height: 40px;
            border: 1px solid var(--gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            font-size: 18px;
        }

        .social-links a:hover {
            background: var(--gold);
            color: var(--charcoal);
        }

        .footer-bottom {
            max-width: 1400px;
            margin: 0 auto;
            padding-top: 40px;
            border-top: 1px solid rgba(212, 165, 116, 0.2);
            text-align: center;
            font-size: 13px;
            color: rgba(254, 253, 251, 0.6);
        }

        /* ANIMATIONS */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in-up {
            animation: fadeInUp 0.6s ease forwards;
        }

        /* SCROLL ANIMATIONS */
        .scroll-reveal {
            opacity: 0;
            transform: translateY(40px);
        }

        .scroll-reveal.visible {
            animation: fadeInUp 0.6s ease forwards;
        }

        /* RESPONSIVE */
        @media (max-width: 1024px) {
            section {
                padding: 80px 40px;
            }

            nav {
                padding: 15px 40px;
            }

            .hero {
                padding: 60px 40px;
                flex-direction: column;
                text-align: center;
            }

            .hero h1 {
                font-size: 48px;
            }

            .nav-links {
                gap: 30px;
            }

            .philosophy-content {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            section {
                padding: 60px 20px;
            }

            nav {
                padding: 12px 20px;
            }

            .nav-links {
                gap: 15px;
                font-size: 12px;
            }

            .hero {
                padding: 80px 20px 40px;
                height: auto;
                min-height: 100vh;
            }

            .hero h1 {
                font-size: 40px;
                margin-bottom: 20px;
            }

            .hero-subtitle {
                font-size: 16px;
            }

            .hero-image {
                height: 300px;
                width: 100%;
            }

            .section-title {
                font-size: 32px;
            }

            .featured-works {
                grid-template-columns: 1fr;
            }

            .services-grid {
                grid-template-columns: 1fr;
            }

            .testimonials-grid {
                grid-template-columns: 1fr;
            }

            .final-cta {
                padding: 80px 20px;
            }

            .final-cta h2 {
                font-size: 32px;
            }

            .footer-content {
                grid-template-columns: 1fr;
                gap: 40px;
            }
        }
    </style>
</head>
<body>
    <!-- STAR CANVAS - lives in background, reacts to cursor -->
    <canvas id="star-canvas"></canvas>

